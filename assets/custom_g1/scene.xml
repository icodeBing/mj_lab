<mujoco model="g1 scene">
  <include file="g1.xml"/>

  <statistic center="0.3 0 .8" extent="1" meansize="0.08"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <global azimuth="180" elevation="-20"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512"
      mark="cross" markrgb=".8 .8 .8"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" directional="true"/>
    <geom name="floor" size="1 1 0.01" type="plane" material="grid"/>
  </worldbody>

  <keyframe>
    <!-- `stand` is the startup pose that policy/run_policy.py resets the G1 to,
         so its left arm MUST match RefConfig.default_qpos / default_motor_pos
         in config/g1.gin. Otherwise the arm has to travel to the commanded pose
         at startup, and that uncompensated motion is read as a spurious
         external force (see the door-push notes in config/g1.gin). -->
    <key name="stand"
      qpos="
      0 0 0.79
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      -1.6 0.3 0 0 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
    <!-- Same door-push pose, but with the base at the settled standing height
         (0.755) so the feet are in contact. Use this keyframe with
         policy/diagnose_dynamics.py, which only calls mj_forward and therefore
         needs a state that already has ground contact. -->
    <key name="door_push"
      qpos="
      0 0 0.755
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      -1.6 0.3 0 0 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
  </keyframe>
</mujoco>
